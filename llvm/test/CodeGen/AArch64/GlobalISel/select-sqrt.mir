---
name:            sqrt_float
legalized:       true
regBankSelected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: fpr }
  - { id: 1, class: fpr }
body:             |
  bb.0:
    liveins: $s0
    ; CHECK-LABEL: name: sqrt_float
    ; CHECK: liveins: $s0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:fpr32 = COPY $s0
    ; CHECK-NEXT: [[FSQRTSr:%[0-9]+]]:fpr32 = nofpexcept FSQRTSr [[COPY]], implicit $fpcr
    ; CHECK-NEXT: $s0 = COPY [[FSQRTSr]]
    %0:fpr(f32) = COPY $s0
    %1:fpr(f32) = G_FSQRT %0
    $s0 = COPY %1(f32)

...
