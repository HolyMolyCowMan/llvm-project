registers:
  - { id: 0, class: _ }
body:             |
  bb.1.entry:
    liveins: $h0

    ; CHECK-LABEL: name: passFp16
    ; CHECK: liveins: $h0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:fpr(s16) = COPY $h0
