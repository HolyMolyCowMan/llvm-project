tracksRegLiveness: true
registers:
  - { id: 0, class: _}
  - { id: 1, class: _}
  - { id: 2, class: _}
  - { id: 3, class: _}
body:             |
  bb.1:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: bitcast_s128
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(s64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr(s64) = COPY $x1
    ; CHECK-NEXT: [[MV:%[0-9]+]]:fpr(s128) = G_MERGE_VALUES [[COPY]](s64), [[COPY1]](s64)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:fpr(<2 x s64>) = G_BITCAST [[MV]](s128)
    ; CHECK-NEXT: $q0 = COPY [[BITCAST]](<2 x s64>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %0(s64) = COPY $x0
    %1(s64) = COPY $x1
    %3(s128) = G_MERGE_VALUES %0(s64), %1(s64)
    %2(<2 x s64>) = G_BITCAST %3(s128)
    $q0 = COPY %2(<2 x s64>)
    RET_ReallyLR implicit $q0

...

---
# This test checks that we issue the proper mapping
# for copy of size > 64.
# The mapping should be the same as G_BITCAST.
name:            copy_s128
legalized: true
tracksRegLiveness: true
registers:
  - { id: 0, class: _}
  - { id: 1, class: _}
  - { id: 2, class: _}
  - { id: 3, class: _}
  - { id: 4, class: _}
body:             |
  bb.1:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: copy_s128
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(s64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr(s64) = COPY $x1
    ; CHECK-NEXT: [[MV:%[0-9]+]]:fpr(s128) = G_MERGE_VALUES [[COPY]](s64), [[COPY1]](s64)
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:fpr(s128) = COPY [[MV]](s128)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:fpr(<2 x s64>) = G_BITCAST [[COPY2]](s128)
    ; CHECK-NEXT: $q0 = COPY [[BITCAST]](<2 x s64>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %0(s64) = COPY $x0
    %1(s64) = COPY $x1
    %3(s128) = G_MERGE_VALUES %0(s64), %1(s64)
    %4(s128) = COPY %3(s128)
    %2(<2 x s64>) = G_BITCAST %4(s128)
    $q0 = COPY %2(<2 x s64>)
    RET_ReallyLR implicit $q0

...

---
# This test checks that we issue the proper mapping
# for copy of size > 64 when the input is neither
# a physcal register nor a generic register.
# This used to crash when we moved to the statically
# computed mapping, because we were assuming non-physregs
# were generic registers and thus have a type, whereas
# it is not necessarily the case.
name:            copy_s128_from_load
legalized: true
tracksRegLiveness: true
registers:
  - { id: 0, class: fpr128}
  - { id: 1, class: _}
body:             |
  bb.1:
    liveins: $x0
    ; CHECK-LABEL: name: copy_s128_from_load
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[LDRQui:%[0-9]+]]:fpr128 = LDRQui killed $x0, 0
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:fpr(s128) = COPY [[LDRQui]]
    ; CHECK-NEXT: $q0 = COPY [[COPY]](s128)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %0 = LDRQui killed $x0, 0
    %1(s128) = COPY %0
    $q0 = COPY %1(s128)
    RET_ReallyLR implicit $q0

...

---
# This test checks that we issue the proper mapping
# for copy of size == 16 when the destination is a fpr
# physical register and the source a gpr.
# We used to crash because we thought that mapping couldn't
# exist in a copy.
name:            copy_fp16
legalized: true
tracksRegLiveness: true
registers:
  - { id: 0, class: _}
  - { id: 1, class: _}
body:             |
  bb.1:
    liveins: $w0
    ; CHECK-LABEL: name: copy_fp16
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(s32) = COPY $w0
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:gpr(s16) = G_TRUNC [[COPY]](s32)
    ; CHECK-NEXT: $h0 = COPY [[TRUNC]](s16)
    ; CHECK-NEXT: RET_ReallyLR implicit $h0
    %0(s32) = COPY $w0
    %1(s16) = G_TRUNC %0(s32)
    $h0 = COPY %1(s16)
    RET_ReallyLR implicit $h0

...


---
# Make sure the greedy mode is able to take advantage of the
# alternative mappings of G_LOAD to coalesce the whole chain
# of computation on GPR.
name:            greedyWithChainOfComputation
legalized:       true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
  - { id: 3, class: _ }
  - { id: 4, class: _ }
  - { id: 5, class: _ }
# No repairing should be necessary for both modes.
body:             |
  bb.0:
    liveins: $x0, $x1

    ; FAST-LABEL: name: greedyWithChainOfComputation
    ; FAST: liveins: $x0, $x1
    ; FAST-NEXT: {{  $}}
    ; FAST-NEXT: [[COPY:%[0-9]+]]:gpr(s64) = COPY $x0
    ; FAST-NEXT: [[COPY1:%[0-9]+]]:gpr(p0) = COPY $x1
    ; FAST-NEXT: [[COPY2:%[0-9]+]]:fpr(s64) = COPY [[COPY]](s64)
    ; FAST-NEXT: [[BITCAST:%[0-9]+]]:fpr(<2 x s32>) = G_BITCAST [[COPY2]](s64)
    ; FAST-NEXT: [[LOAD:%[0-9]+]]:fpr(<2 x s32>) = G_LOAD [[COPY1]](p0) :: (load (<2 x s32>) from %ir.addr)
    ; FAST-NEXT: [[OR:%[0-9]+]]:fpr(<2 x s32>) = G_OR [[BITCAST]], [[LOAD]]
    ; FAST-NEXT: [[BITCAST1:%[0-9]+]]:fpr(s64) = G_BITCAST [[OR]](<2 x s32>)
    ; FAST-NEXT: $x0 = COPY [[BITCAST1]](s64)
    ; FAST-NEXT: RET_ReallyLR implicit $x0
    ;
    ; GREEDY-LABEL: name: greedyWithChainOfComputation
    ; GREEDY: liveins: $x0, $x1
    ; GREEDY-NEXT: {{  $}}
    ; GREEDY-NEXT: [[COPY:%[0-9]+]]:gpr(s64) = COPY $x0
    ; GREEDY-NEXT: [[COPY1:%[0-9]+]]:gpr(p0) = COPY $x1
    ; GREEDY-NEXT: [[BITCAST:%[0-9]+]]:gpr(<2 x s32>) = G_BITCAST [[COPY]](s64)
    ; GREEDY-NEXT: [[LOAD:%[0-9]+]]:gpr(<2 x s32>) = G_LOAD [[COPY1]](p0) :: (load (<2 x s32>) from %ir.addr)
    ; GREEDY-NEXT: [[OR:%[0-9]+]]:gpr(<2 x s32>) = G_OR [[BITCAST]], [[LOAD]]
    ; GREEDY-NEXT: [[BITCAST1:%[0-9]+]]:gpr(s64) = G_BITCAST [[OR]](<2 x s32>)
    ; GREEDY-NEXT: $x0 = COPY [[BITCAST1]](s64)
    ; GREEDY-NEXT: RET_ReallyLR implicit $x0
    %0(s64) = COPY $x0
    %1(p0) = COPY $x1
    %2(<2 x s32>) = G_BITCAST %0(s64)
    %3(<2 x s32>) = G_LOAD %1(p0) :: (load (<2 x s32>) from %ir.addr)
    %4(<2 x s32>) = G_OR %2, %3
    %5(s64) = G_BITCAST %4(<2 x s32>)
    $x0 = COPY %5(s64)
    RET_ReallyLR implicit $x0

...

---
# Make sure we map what looks like floating point
# loads to floating point register bank.
name:            floatingPointLoad
legalized:       true

registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
  - { id: 3, class: _ }

# No repairing should be necessary for both modes.
# %0 has been mapped to GPR, we need to repair to match FPR.

body:             |
  bb.0:
    liveins: $x0, $x1

    ; CHECK-LABEL: name: floatingPointLoad
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(s64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr(p0) = COPY $x1
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:fpr(s64) = G_LOAD [[COPY1]](p0) :: (load (s64) from %ir.addr)
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:fpr(s64) = COPY [[COPY]](s64)
    ; CHECK-NEXT: [[FADD:%[0-9]+]]:fpr(s64) = G_FADD [[COPY2]], [[LOAD]]
    ; CHECK-NEXT: $x0 = COPY [[FADD]](s64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %0(s64) = COPY $x0
    %1(p0) = COPY $x1
    %2(s64) = G_LOAD %1(p0) :: (load (s64) from %ir.addr)
    %3(s64) = G_FADD %0, %2
    $x0 = COPY %3(s64)
    RET_ReallyLR implicit $x0

...

---
# Make sure we map what looks like floating point
# stores to floating point register bank.
name:            floatingPointStore
legalized:       true

registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }

# %0 has been mapped to GPR, we need to repair to match FPR.

body:             |
  bb.0:
    liveins: $x0, $x1

    ; CHECK-LABEL: name: floatingPointStore
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(s64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr(p0) = COPY $x1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:fpr(s64) = COPY [[COPY]](s64)
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:fpr(s64) = COPY [[COPY]](s64)
    ; CHECK-NEXT: [[FADD:%[0-9]+]]:fpr(s64) = G_FADD [[COPY2]], [[COPY3]]
    ; CHECK-NEXT: G_STORE [[FADD]](s64), [[COPY1]](p0) :: (store (s64) into %ir.addr)
    ; CHECK-NEXT: RET_ReallyLR
    %0(s64) = COPY $x0
    %1(p0) = COPY $x1
    %2(s64) = G_FADD %0, %0
    G_STORE %2(s64), %1(p0) :: (store (s64) into %ir.addr)
    RET_ReallyLR

...

---
# Make sure we map FPEXT on FPR register bank.
name:            fp16Ext32
alignment:       4
legalized:       true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
# %0 has been mapped to GPR, we need to repair to match FPR.

body:             |
  bb.1:
    liveins: $w0

    ; CHECK-LABEL: name: fp16Ext32
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(s32) = COPY $w0
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:gpr(s16) = G_TRUNC [[COPY]](s32)
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:fpr(s16) = COPY [[TRUNC]](s16)
    ; CHECK-NEXT: [[FPEXT:%[0-9]+]]:fpr(s32) = G_FPEXT [[COPY1]](s16)
    ; CHECK-NEXT: $s0 = COPY [[FPEXT]](s32)
    ; CHECK-NEXT: RET_ReallyLR implicit $s0
    %1(s32) = COPY $w0
    %0(s16) = G_TRUNC %1(s32)
    %2(s32) = G_FPEXT %0(s16)
    $s0 = COPY %2(s32)
    RET_ReallyLR implicit $s0

...

